---
import Text from '../sabloane/Text.astro';
// Inlocuieste cu Site Key din Cloudflare Turnstile (public):
const TURNSTILE_SITEKEY = '0x4AAAAAAD8_7NfDk8WAXt6-';
---
<Text titlu="Contact" descriere="Scrie-ne o intrebare, o corectie sau o propunere." eticheta="bermo" lead="Ai gasit o greseala, ai o intrebare sau o propunere de articol? Scrie-ne.">
  <p>Ne poti scrie direct la <a href="mailto:contact@bermo.ro">contact@bermo.ro</a> sau prin formularul de mai jos. Raspundem de obicei in cateva zile.</p>

  <form class="formular" id="formContact" novalidate>
    <div><label for="nume">Nume</label><input id="nume" name="nume" type="text" maxlength="120" required /></div>
    <div><label for="email">Email</label><input id="email" name="email" type="email" maxlength="160" required /></div>
    <div><label for="mesaj">Mesaj</label><textarea id="mesaj" name="mesaj" maxlength="5000" required></textarea></div>
    <div class="cf-turnstile" data-sitekey={TURNSTILE_SITEKEY} data-theme="auto" style="margin:4px 0"></div>
    <button class="btn" type="submit" id="btnTrimite" style="width:auto">Trimite mesajul</button>
    <p id="stareForm" role="status" aria-live="polite" style="margin:4px 0 0;font-size:14px;display:none"></p>
  </form>

  <p>Pentru detalii despre date, vezi <a href="/confidentialitate/">politica de confidentialitate</a>.</p>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  <script is:inline>
    (function () {
      var f = document.getElementById('formContact');
      var stare = document.getElementById('stareForm');
      var btn = document.getElementById('btnTrimite');
      function arata(msg, ok) {
        stare.textContent = msg;
        stare.style.display = 'block';
        stare.style.color = ok ? 'var(--accent)' : '#c94a4a';
      }
      f.addEventListener('submit', async function (e) {
        e.preventDefault();
        var tokenEl = f.querySelector('[name="cf-turnstile-response"]');
        var token = tokenEl ? tokenEl.value : '';
        if (!token) { arata('Confirma casuta „nu sunt robot" si reincearca.', false); return; }
        btn.disabled = true; btn.textContent = 'Se trimite...';
        try {
          var res = await fetch('/api/contact', { method: 'POST', body: new FormData(f) });
          var data = await res.json();
          if (data.ok) {
            f.reset();
            if (window.turnstile) window.turnstile.reset();
            arata('Mesajul a fost trimis. Multumim, revenim in cateva zile.', true);
          } else {
            arata(data.error || 'A aparut o eroare. Reincearca.', false);
            if (window.turnstile) window.turnstile.reset();
          }
        } catch (err) {
          arata('Nu am putut trimite mesajul. Scrie-ne direct la contact@bermo.ro.', false);
        } finally {
          btn.disabled = false; btn.textContent = 'Trimite mesajul';
        }
      });
    })();
  </script>
</Text>
