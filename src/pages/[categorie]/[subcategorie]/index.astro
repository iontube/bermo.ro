---
import Baza from '../../../sabloane/Baza.astro';
import { categorii } from '../../../date/nav.js';
import { getArticole } from '../../../date/articole.js';
import '../../../stiluri/categorie.css';

export async function getStaticPaths() {
  const cai = [];
  for (const c of categorii) {
    for (const s of c.subcategorii) {
      cai.push({ params: { categorie: c.slug, subcategorie: s.slug }, props: { c, s } });
    }
  }
  return cai;
}
const { c, s } = Astro.props;
const toate = (await getArticole())
  .filter((a) => a.data.categorieSlug === c.slug && a.data.subcategorieSlug === s.slug)
  .sort((a, b) => b.data.data - a.data.data);
const urlArt = (a) => `/${a.id}/`;

const SITE = 'https://bermo.ro';
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${s.nume} · ${c.nume}`,
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Acasa', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: c.nume, item: `${SITE}/${c.slug}/` },
    { '@type': 'ListItem', position: 3, name: s.nume },
  ],
}];
---
<Baza titlu={`${s.nume} · ${c.nume}`} descriere={`Cele mai bune ${s.nume.toLowerCase()} din ${c.nume.toLowerCase()}, alese pe recenzii reale.`} jsonLd={jsonLd}>
  <main class="wrap">
    <nav class="crumb">
      <a href="/">Acasa</a><span class="sep">/</span>
      <a href={`/${c.slug}/`}>{c.nume}</a><span class="sep">/</span>
      <span class="cur">{s.nume}</span>
    </nav>

    <div class="cathead">
      <span class="lab">{c.nume}</span>
      <h1>{s.nume}</h1>
      <p>Cele mai bune {s.nume.toLowerCase()} din 2026, alese pe recenzii reale si raport pret-calitate, nu pe fisa de produs.</p>
    </div>

    <nav class="subnav" aria-label="Subcategorii">
      <a href={`/${c.slug}/`}>Toate</a>
      {c.subcategorii.map((x) => <a href={`/${c.slug}/${x.slug}/`} class={x.slug === s.slug ? 'active' : ''}>{x.nume}</a>)}
    </nav>

    <section class="listsec">
      {toate.length > 0 ? (
        <div class="art-grid">
          {toate.map((a) => (
            <a class="art" href={urlArt(a)}>
              <div class="ph">{a.data.imagine ? <img src={a.data.imagine} alt={a.data.titlu} loading="lazy" /> : "imagine"}</div>
              <div class="abody">
                <span class="akick">{a.data.subcategorie ?? a.data.categorie}</span>
                <h2>{a.data.titlu}</h2>
                <p>{a.data.descriere}</p>
                <div class="ameta"><span>{a.data.autor}</span><span>{a.data.minute} min</span></div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="gol">Inca nu avem articole in aceasta subcategorie. Revino curand.</div>
      )}
    </section>
  </main>
</Baza>
