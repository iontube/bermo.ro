---
import Baza from '../sabloane/Baza.astro';
import { categoriiGrid } from '../date/nav.js';
---
<Baza titlu="Pagina nu a fost gasita" descriere="Pagina cautata nu exista. Incearca o cautare sau alege o categorie.">
  <main class="wrap" style="text-align:center;padding:70px 0 60px;max-width:640px">
    <div style="font-family:var(--mono);font-size:13px;letter-spacing:.1em;color:var(--accent);text-transform:uppercase">Eroare 404</div>
    <h1 style="font-size:clamp(28px,6vw,44px);margin:14px 0 12px">Pagina asta nu exista</h1>
    <p style="font-size:17px;color:var(--ink-2);max-width:44ch;margin:0 auto 26px">Poate a fost mutata sau linkul e gresit. Incearca o cautare sau mergi direct la o categorie.</p>
    <form id="form404" action="/articole/" method="get" role="search" style="margin:0 auto 30px;display:flex;align-items:center;gap:8px;background:var(--card);border:1px solid var(--line-2);border-radius:11px;padding:6px 6px 6px 14px;max-width:440px;box-shadow:var(--shadow)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;color:var(--muted);flex:none"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4-4"/></svg>
      <input type="search" name="cauta" placeholder="Cauta pe bermo" aria-label="Cauta pe bermo" required style="border:0;background:none;font:inherit;font-size:15px;color:var(--ink);width:100%;outline:none;padding:8px 0" />
      <button class="btn" style="width:auto">Cauta</button>
    </form>
    <script is:inline>
      (function () {
        var f = document.getElementById('form404');
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var v = f.querySelector('input[name="cauta"]').value.trim();
          var slug = v.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
          location.href = slug ? '/cauta/' + slug + '/' : '/articole/';
        });
      })();
    </script>
    <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center">
      {categoriiGrid.map((c) => (<a href={`/${c.slug}/`} style="font-size:13.5px;color:var(--ink-2);background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:7px 14px">{c.nume}</a>))}
    </div>
  </main>
</Baza>
